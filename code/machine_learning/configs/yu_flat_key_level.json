{
  "name": "Yu扁平化關鍵點位",
  "version": 1,
  "date_column": "日期",
  "taiex": {
    "relation": "report.v_taiex_report_turnover",
    "fields": ["開盤價", "最高價", "最低價", "收盤價", "成交金額"],
    "column_map": {"open": "開盤價", "high": "最高價", "low": "最低價", "close": "收盤價", "volume": "成交金額"}
  },
  "futures": {
    "relation": "report.v_futures_report_daily",
    "entity_filter": {"futures_id": "TX"},
    "mapped_fields": [
      {"field": "全日開", "session": "全日", "kind": "開盤"},
      {"field": "全日高", "session": "全日", "kind": "高點"},
      {"field": "全日低", "session": "全日", "kind": "低點"},
      {"field": "全日收", "session": "全日", "kind": "收盤"},
      {"field": "日盤開", "session": "日盤", "kind": "開盤"},
      {"field": "日盤高", "session": "日盤", "kind": "高點"},
      {"field": "日盤低", "session": "日盤", "kind": "低點"},
      {"field": "日盤收", "session": "日盤", "kind": "收盤"}
    ]
  },
  "features": {"load_calendar_days": 550, "windows": [5, 10, 20, 60, 120], "atr_window": 20},
  "scoring": {
    "volume_window": 20,
    "shape_percentile_window": 60,
    "pivot_windows": [5, 10, 20, 60],
    "large_volume_ratio": 1.3,
    "long_body_atr": 0.8,
    "long_shadow_atr": 0.45,
    "formation_weights": {"volume": 2.0, "pivot": 2.0, "body": 1.5, "shadow": 1.5},
    "validity": {
      "break_buffer_atr": 0.1, "touch_buffer_atr": 0.15, "age_half_life_rows": 40,
      "distance_decay_atr": 6.0, "break_penalty": 0.18, "cross_penalty": 0.08,
      "formation_share": 0.55, "recency_share": 0.25, "proximity_share": 0.20
    }
  },
  "output": {"top_key_k": 30, "minimum_formation_score": 2.5, "minimum_validity_score": 1.2},
  "flat_labels": {
    "deduplicate_points": 2.0,
    "candidate_deduplicate_points": 2.0,
    "hit_tolerance_points": 15.0
  }
}
