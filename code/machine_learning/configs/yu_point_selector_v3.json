    "current_fields": [
      {"field": "夜盤開", "session": "夜盤", "kind": "開盤"},
      {"field": "夜盤收", "session": "夜盤", "kind": "收盤"},
      {"field": "夜盤高", "session": "夜盤", "kind": "高點"},
      {"field": "夜盤低", "session": "夜盤", "kind": "低點"},
      {"field": "全5MA", "session": "全日", "kind": "5日均"},
      {"field": "全10MA", "session": "全日", "kind": "10日均"},
      {"field": "全20MA", "session": "全日", "kind": "20日均"},
      {"field": "全布林上軌", "session": "全日", "kind": "布林上軌"},
      {"field": "全布林下軌", "session": "全日", "kind": "布林下軌"},
      {"field": "全5_明日扣抵值", "session": "全日", "kind": "5日均扣抵"},
      {"field": "全10_明日扣抵值", "session": "全日", "kind": "10日均扣抵"},
      {"field": "日5MA", "session": "日盤", "kind": "5日均"},
      {"field": "日10MA", "session": "日盤", "kind": "10日均"},
      {"field": "日20MA", "session": "日盤", "kind": "20日均"},
