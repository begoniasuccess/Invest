        "歷史同情境類型盤別選用率", "歷史同情境類型選用次數"
      ]
    },
    "feature_sets": [
      {"name": "A_候選本身", "groups": ["candidate_core"]},
      {"name": "B_候選加Yu歷史", "groups": ["candidate_core", "yu_history"]},
      {"name": "C_候選加Yu歷史加期貨", "groups": ["candidate_core", "yu_history", "tx_report"]},
      {"name": "D_候選加Yu歷史加加權", "groups": ["candidate_core", "yu_history", "taiex_report"]},
      {"name": "E_候選加Yu歷史加期貨加加權", "groups": ["candidate_core", "yu_history", "tx_report", "taiex_report"]},
      {"name": "F_全部加Yu當日判斷", "groups": ["candidate_core", "yu_history", "tx_report", "taiex_report", "yu_context"], "research_only": true}
    ]
