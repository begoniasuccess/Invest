        "上影百分位_20", "上影百分位_60", "上影百分位_120"
      ],
      "長下影": [
        "下影點數", "下影占振幅", "下影_ATR倍數",
        "下影百分位_20", "下影百分位_60", "下影百分位_120"
      ],
      "跳空缺口": [
        "跳空缺口絕對點數", "跳空缺口_昨收_pct_重算", "跳空缺口_ATR倍數"
      ]
    },
    "feature_directions": {
      "是否截至當日5日新高": ">=", "是否截至當日10日新高": ">=", "是否截至當日20日新高": ">=", "是否截至當日60日新高": ">=",
      "高點突破前5日點數": ">=", "高點突破前10日點數": ">=", "高點突破前20日點數": ">=", "高點突破前60日點數": ">=",
      "是否截至當日5日新低": ">=", "是否截至當日10日新低": ">=", "是否截至當日20日新低": ">=", "是否截至當日60日新低": ">=",
      "低點跌破前5日點數": "<=", "低點跌破前10日點數": "<=", "低點跌破前20日點數": "<=", "低點跌破前60日點數": "<=",
      "量比_5": ">=", "量比_10": ">=", "量比_20": ">=", "量比_60": ">=", "量比_120": ">=",
      "成交量百分位_20": ">=", "成交量百分位_60": ">=", "成交量百分位_120": ">=",
      "實體絕對點數": ">=", "實體占振幅": ">=", "實體_ATR倍數": ">=",
      "實體百分位_20": ">=", "實體百分位_60": ">=", "實體百分位_120": ">=",
      "上影點數": ">=", "上影占振幅": ">=", "上影_ATR倍數": ">=",
      "上影百分位_20": ">=", "上影百分位_60": ">=", "上影百分位_120": ">=",
      "下影點數": ">=", "下影占振幅": ">=", "下影_ATR倍數": ">=",
      "下影百分位_20": ">=", "下影百分位_60": ">=", "下影百分位_120": ">=",
      "跳空缺口絕對點數": ">=", "跳空缺口_昨收_pct_重算": ">=", "跳空缺口_ATR倍數": ">="
    },
    "prediction_min_rule_hits": 2,
