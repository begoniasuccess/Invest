{
  "name": "Yu加權關鍵K規則反推與期現貨映射驗證",
  "version": 5,
  "date_column": "日期",
  "taiex": {
    "relation": "report.v_taiex_report_turnover",
    "fields": [
      "開盤價", "最高價", "最低價", "收盤價", "成交金額", "跳空缺口",
      "漲跌幅_pct", "實體_pct", "上影_pct", "下影_pct",
      "5日最大量", "10日最大量", "20日最大量", "60日最大量"
    ],
    "column_map": {
      "open": "開盤價", "high": "最高價", "low": "最低價",
      "close": "收盤價", "volume": "成交金額"
    },
    "gap_column": "跳空缺口"
  },
  "futures": {
    "relation": "report.v_futures_report_daily",
    "entity_filter": {"futures_id": "TX"},
    "fields": [
      "全日開", "全日高", "全日低", "全日收",
      "日盤開", "日盤高", "日盤低", "日盤收"
    ],
    "column_map": {
      "open": "日盤開", "high": "日盤高", "low": "日盤低", "close": "日盤收"
    },
    "mapping_column_maps": {
      "日盤": {"open": "日盤開", "high": "日盤高", "low": "日盤低", "close": "日盤收"},
      "全日": {"open": "全日開", "high": "全日高", "low": "全日低", "close": "全日收"}
    }
  },
  "features": {
    "load_calendar_days": 1500,
    "windows": [5, 10, 20, 60, 120],
    "atr_window": 20
  },
  "scoring": {
    "volume_window": 20,
    "shape_percentile_window": 60,
    "pivot_windows": [5, 10, 20, 60],
    "large_volume_ratio": 1.3,
    "long_body_atr": 0.8,
    "long_shadow_atr": 0.45,
    "formation_weights": {"volume": 2.0, "pivot": 2.0, "body": 1.5, "shadow": 1.5},
    "validity": {
      "break_buffer_atr": 0.1, "touch_buffer_atr": 0.15,
      "age_half_life_rows": 40, "distance_decay_atr": 6.0,
      "break_penalty": 0.18, "cross_penalty": 0.08,
      "formation_share": 0.55, "recency_share": 0.25, "proximity_share": 0.2
    }
  },
  "discovery": {
    "candidate_calendar_days": 900,
    "exact_tolerance_points": 8,
    "price_tolerance_points": 35,
    "age_decay_calendar_days": 180,
    "accepted_confidence": ["高", "中"],
    "weights": {"price": 4.0, "explicit_date": 8.0, "kind": 3.0, "recency": 0.25},
    "threshold_quantiles": [0.5, 0.6, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95],
    "validation_fraction": 0.25,
    "label_maturity_calendar_days": 45,
    "minimum_rule_positive_samples": 8,
    "event_rules_excluded_from_k_thresholds": ["跳空缺口"],
    "pivot_candidate_calendar_days": 365,
    "pivot_touch_buffer_atr": 0.15,
    "stable_min_lift": 1.0,
    "stable_min_validation_positives": 3,
    "stable_min_coverage": 0.2,
    "rule_target_columns": {
      "大量K": "Yu規則_大量K",
      "跳空缺口": "Yu規則_跳空缺口",
      "波段高": "Yu形成原因_波段高K",
      "波段低": "Yu形成原因_波段低K",
      "長紅黑K": "Yu規則_長紅黑K",
      "長上影": "Yu規則_長上影",
      "長下影": "Yu規則_長下影"
    },
    "rule_features": {
      "大量K": [
        "量比_5", "量比_10", "量比_20", "量比_60", "量比_120",
        "成交量百分位_20", "成交量百分位_60", "成交量百分位_120"
      ],
      "波段高": [
        "是否截至當日5日新高", "是否截至當日10日新高", "是否截至當日20日新高", "是否截至當日60日新高",
        "高點突破前5日點數", "高點突破前10日點數", "高點突破前20日點數", "高點突破前60日點數"
      ],
      "波段低": [
        "是否截至當日5日新低", "是否截至當日10日新低", "是否截至當日20日新低", "是否截至當日60日新低",
        "低點跌破前5日點數", "低點跌破前10日點數", "低點跌破前20日點數", "低點跌破前60日點數"
      ],
      "長紅黑K": [
