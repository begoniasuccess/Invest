{
  "model_key": "tx_close_direction",
  "model_name": "台指期日盤收盤漲跌方向",
  "description": "使用目標交易日前一交易日已知資料，預測目標日日盤收盤相對前一日日盤收盤為漲或跌。",
  "target_market": "TX",
  "target_name": "日盤收盤方向",
  "version_no": 1,
  "algorithm": "random_forest",
  "source_relation": "report.v_futures_report_daily_model",
  "date_column": "日期",
  "entity_filter": {"futures_id": "TX"},
  "feature_columns": [
    "月", "週次", "日價漲跌_pct", "日收開_昨收_pct", "日振幅_昨收_pct",
    "日量增減_五日_pct", "日量增減_二十日_pct", "日5MA乖離率",
    "日20MA乖離率", "日60MA乖離率", "夜盤收", "夜盤開", "夜盤高",
    "夜盤低", "夜成交量", "夜法人多單量", "夜法人空單量"
  ],
  "target_config": {
    "price_column": "日盤收",
    "flat_threshold_pct": 0.0,
    "labels": {"-1": "跌", "0": "平", "1": "漲"}
  },
  "model_params": {
    "n_estimators": 500,
    "max_depth": 6,
    "min_samples_leaf": 8,
    "class_weight": "balanced_subsample",
    "n_jobs": -1
  },
  "training_config": {
    "minimum_training_rows": 500,
    "maximum_training_rows": null,
    "refit_every": 1,
    "store_feature_snapshot": true,
    "random_seed": 42
  }
}
