{
  "name": "Yu關鍵點位候選產生與人工審核V3",
  "version": 3,
  "date_column": "日期",
  "taiex": {
    "relation": "report.v_taiex_report_turnover",
    "fields": [
      "開盤價", "最高價", "最低價", "收盤價", "成交金額", "跳空缺口",
      "5MA", "10MA", "20MA", "60MA", "布林上軌", "布林下軌"
    ],
    "column_map": {
      "open": "開盤價", "high": "最高價", "low": "最低價",
      "close": "收盤價", "volume": "成交金額"
    },
    "dynamic_fields": [
      {"field": "5MA", "kind": "5MA", "deviation_ratios": [-0.02, 0.02]},
      {"field": "10MA", "kind": "10MA", "deviation_ratios": [-0.02, 0.02]},
      {"field": "20MA", "kind": "20MA"},
      {"field": "60MA", "kind": "60MA"},
      {"field": "布林上軌", "kind": "布林上軌"},
      {"field": "布林下軌", "kind": "布林下軌"}
    ]
  },
  "futures": {
    "relation": "report.v_futures_report_daily",
    "entity_filter": {"futures_id": "TX"},
    "mapped_fields": [
      {"field": "全日開", "session": "全日", "kind": "開盤"},
      {"field": "全日高", "session": "全日", "kind": "高點"},
      {"field": "全日低", "session": "全日", "kind": "低點"},
      {"field": "全日收", "session": "全日", "kind": "收盤"}
    ]
  },
  "features": {
    "load_calendar_days": 1800,
    "windows": [5, 10, 20, 60, 120],
    "atr_window": 20
  },
  "scoring": {
    "volume_window": 20,
    "shape_percentile_window": 60,
    "pivot_windows": [5, 10, 20, 60],
    "large_volume_ratio": 1.3,
    "long_body_atr": 0.8,
    "long_shadow_atr": 0.45,
    "formation_weights": {"volume": 2.0, "pivot": 2.0, "body": 1.5, "shadow": 1.5},
    "validity": {"age_half_life_rows": 60, "cross_penalty": 0.08}
  },
  "importance_scoring": {
    "weights": {
      "shape": 0.25,
      "point": 0.20,
      "formation": 0.20,
      "validity": 0.20,
      "overlap": 0.15
    },
    "grade_thresholds": {"S": 85, "A": 70, "B": 55, "C": 40},
    "default_visible_grades": ["S", "A", "B"]
  },
  "candidate": {
    "lookback_trading_rows": 500,
    "large_volume_ratio": 1.3,
    "large_volume_percentile": 0.8,
    "long_body_atr": 0.8,
    "long_body_percentile": 0.85,
    "long_shadow_atr": 0.45,
    "long_shadow_percentile": 0.85,
    "pivot_windows": [10, 20, 60],
    "minimum_gap_points": 20,
    "minimum_gap_atr": 0.08,
    "cluster_tolerance_points": 20,
    "cluster_tolerance_atr": 0.05,
    "cluster_max_width_points": 35,
    "cluster_max_width_atr": 0.10,
    "touch_buffer_atr": 0.12,
    "break_buffer_atr": 0.10,
    "confirmed_break_closes": 2,
    "overtested_cross_count": 5,
    "external_round_step": 500,
    "external_round_levels_each_side": 3
  },
  "review": {
    "maximum_zones": 30,
    "maximum_distance_atr": 8.0,
    "coverage_at_k": [10, 20, 30, 40, 50],
    "excluded_statuses": ["INVALIDATED", "OVERTESTED"]
  },
  "known_label_validation": {
    "match_tolerance_points": 35,
    "mode": "WALK_FORWARD_AS_OF_EACH_ANALYSIS_DATE"
  },
  "database": {
    "schema": "research",
    "generator_code": "YU_CANDIDATE_REVIEW_V3"
  }
}
